# Node dependencies
node_modules/
jspm_packages/

# TypeScript compilation output
dist/
build/
*.tsbuildinfo

# Playwright core test artifacts
test-results/
playwright-report/
blob-report/
playwright/.local-browsers/

# Allure Report generated directories and raw data caches
allure-results/
allure-report/
.allure/

# Strictly secure application state session files
# This blocks your generated cookies from being pushed to Git
src/storage/*.json
!src/storage/.gitkeep

# Environment variable configurations and secret keys
.env
.env.local
.env.*.local

# Operating System temporary metadata caches
.DS_Store
Thumbs.db
